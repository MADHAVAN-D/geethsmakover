# ============================================================
# Geeths Makeover 3.0 — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any real secrets to the repo.
# ============================================================

# ---------- Sanity CMS (content: services, gallery, testimonials, offers) ----------
# Create a project at https://sanity.io, then run `npm run dev` inside /sanity
# to open the Studio. Once configured, the website reads content from Sanity.
# When SANITY_PROJECT_ID is empty, the site falls back to local demo content
# (see CONTENT_MODE below) so development works without credentials.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Use Sanity's CDN for production reads (recommended true).
SANITY_USE_CDN=true
# Optional: Studio URL, shown as a link inside the admin dashboard.
SANITY_STUDIO_URL=https://your-project-id.studio.sanity.dev

# ---------- Content mode ----------
# auto  = use Sanity when SANITY_PROJECT_ID is set, otherwise local content (default)
# sanity= force Sanity (will error if SANITY_PROJECT_ID is missing)
# local = force local content (no Sanity calls)
CONTENT_MODE=auto

# ---------- Database (bookings, customers, availability, blocked times) ----------
# SQLite file lives in DATA_DIR (created automatically).
# IMPORTANT for Vercel: the serverless filesystem is ephemeral. Either point
# DATA_DIR at a mounted Volume (Vercel Fluid Compute + Volumes), or swap the
# repository layer (lib/db) for Postgres — the schema is standard SQL.
DATA_DIR=./data

# ---------- Admin authentication ----------
# Username + password for /admin. Use a strong, unique password in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Secret used to sign the admin session cookie. Must be at least 16 characters
# (32+ recommended). Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Local-only: run `npm start` over plain HTTP and still log in (HTTPS is
# normal in production). Leave unset on any public server.
# INSECURE_ADMIN_COOKIES=1

# ---------- Business / WhatsApp ----------
# Display phone (used on the site).
BUSINESS_PHONE=+91 90354 62874
# WhatsApp number in international digits only (no +, spaces or dashes),
# e.g. 919035462874. Used for "Continue on WhatsApp" links.
BUSINESS_WHATSAPP=919035462874

# ---------- Site ----------
# Canonical origin, used for sitemap + Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Runtime timezone ----------
# The store's local wall-clock is used for all dates/times. If your hosting
# environment is not in Asia/Kolkata, set this on the host/Vercel so that
# "today" on the server matches the shop's today:
#   TZ=Asia/Kolkata
